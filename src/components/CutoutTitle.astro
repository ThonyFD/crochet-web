---
// Magazine cut-out letters. Screen readers get the real text; letters are decorative.
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'div';
  size?: 'lg' | 'md' | 'sm';
  class?: string;
}

const { text, as: Tag = 'div', size = 'lg', class: className } = Astro.props;
const words = text.toUpperCase().split(/\s+/).filter(Boolean);
---

<Tag class:list={['cutout', `cutout--${size}`, className]}>
  <span class="sr-only">{text}</span>
  <span class="letters" aria-hidden="true">
    {
      words.map((word) => (
        <span class="word">
          {[...word].map((ch) => (
            <span class="cut">{ch}</span>
          ))}
        </span>
      ))
    }
  </span>
</Tag>

<style>
  .cutout {
    margin: 0;
    font-weight: 400;
    line-height: 1;
  }
  .letters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
  }
  .word {
    display: inline-flex;
    white-space: nowrap;
  }
  .cut {
    display: inline-block;
    padding: 2px 9px;
    margin: 0 1px;
    box-shadow: var(--shadow-chip);
    font-size: var(--cut-size);
    line-height: 1.1;
    color: var(--ink);
  }
  .cut:nth-child(5n + 1) {
    background: var(--pink-50);
    font-family: var(--font-cut-a);
    transform: rotate(-6deg);
  }
  .cut:nth-child(5n + 2) {
    background: var(--yellow-50);
    font-family: var(--font-cut-b);
    font-size: calc(var(--cut-size) * 0.75);
    transform: rotate(4deg);
  }
  .cut:nth-child(5n + 3) {
    background: var(--blue-50);
    font-family: var(--font-cut-c);
    transform: rotate(-3deg);
  }
  .cut:nth-child(5n + 4) {
    background: var(--lavender-50);
    font-family: var(--font-cut-a);
    transform: rotate(7deg);
  }
  .cut:nth-child(5n + 5) {
    background: #fff;
    font-family: var(--font-cut-b);
    font-size: calc(var(--cut-size) * 0.75);
    color: var(--pink-text);
    transform: rotate(-2deg);
  }
  .cutout--lg {
    --cut-size: clamp(30px, 6vw, 40px);
  }
  .cutout--md {
    --cut-size: clamp(22px, 4.5vw, 32px);
  }
  .cutout--sm {
    --cut-size: 24px;
  }
  .cutout--sm .letters {
    gap: 6px 10px;
  }
</style>
