---
import type { ImageMetadata } from 'astro';
import Polaroid from './Polaroid.astro';
import Deco from './Deco.astro';

interface Props {
  title: string;
  text: string;
  photo: ImageMetadata;
}

const { title, text, photo } = Astro.props;
---

<section id="sobre-mi" class="about" aria-labelledby="about-title">
  <div class="in">
    <div class="note ruled">
      <span class="tape y" aria-hidden="true"></span>
      <h2 id="about-title" class="hand">{title}</h2>
      {text.split(/\n{2,}/).map((para) => <p>{para}</p>)}
    </div>
    <div class="side">
      <div class="back gingham torn" aria-hidden="true"></div>
      <Polaroid image={photo} alt="Tejido de Stars & Stuff" tape="blue" class="pic" sizes="190px" widths={[190, 380]} />
      <Deco kind="star" color="var(--orange-400)" size={44} style="bottom:0;right:10px" />
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--cream);
    padding: 50px clamp(16px, 4vw, 40px);
    overflow: hidden;
    scroll-margin-top: 10px;
  }
  .in {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    gap: 40px;
    align-items: center;
  }
  .note {
    flex: 1.4;
    position: relative;
    padding: 26px 28px;
    transform: rotate(-1.5deg);
    font-size: 16px;
  }
  .note h2 {
    font-size: 34px;
    margin: 0 0 4px;
    line-height: 1.1;
  }
  .note p {
    margin: 0;
  }
  .side {
    flex: 1;
    position: relative;
    height: 260px;
    min-width: 240px;
  }
  .back {
    position: absolute;
    inset: 10px 20px 20px 0;
    transform: rotate(4deg);
  }
  .side :global(.pic) {
    position: absolute;
    top: 0;
    left: 60px;
    width: 190px;
    transform: rotate(-5deg);
  }
  @media (max-width: 767px) {
    .in {
      flex-direction: column;
      align-items: stretch;
    }
    .side {
      min-width: 0;
    }
    .side :global(.pic) {
      left: 50%;
      margin-left: -95px;
    }
  }
</style>
