---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import StickerButton from './StickerButton.astro';
import { getSettings } from '../lib/content';
import { genericMessage, whatsappUrl } from '../lib/whatsapp';

const site = await getSettings();
---

<footer id="pedidos" class="foot">
  <div class="msg">
    <Image src={logo} alt="" width={64} height={64} densities={[1, 2]} class="logo" />
    <p class="hand">¿quieres uno en tus colores? ✦</p>
  </div>
  <div class="actions">
    <StickerButton href={whatsappUrl(site.whatsapp, genericMessage())}>💬 WhatsApp</StickerButton>
    <StickerButton href={site.instagram} variant="ig">📷 Instagram</StickerButton>
  </div>
</footer>

<style>
  .foot {
    background: var(--pink-100);
    padding: 26px clamp(16px, 4vw, 40px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .msg {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .msg :global(.logo) {
    transform: rotate(-8deg);
  }
  .msg p {
    font-size: 28px;
    margin: 0;
  }
  .actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
