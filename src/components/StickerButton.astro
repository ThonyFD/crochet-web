---
interface Props {
  href: string;
  variant?: 'wa' | 'ig';
  size?: 'lg' | 'md';
  class?: string;
}

const { href, variant = 'wa', size = 'lg', class: className } = Astro.props;
---

<a class:list={['sticker', `sticker--${variant}`, `sticker--${size}`, className]} href={href} target="_blank" rel="noopener">
  <slot />
</a>

<style>
  .sticker {
    display: inline-block;
    color: #123;
    font-weight: 700;
    text-decoration: none;
    border: 3px solid #fff;
    border-radius: 30px;
    box-shadow:
      0 0 0 2px var(--line),
      3px 4px 0 2px var(--line);
    transform: rotate(-2deg);
    transition: transform 0.15s ease;
  }
  .sticker:hover {
    transform: rotate(0deg) translateY(-2px);
  }
  .sticker--wa {
    background: var(--green-wa);
  }
  .sticker--ig {
    background: var(--lavender-50);
  }
  .sticker--lg {
    padding: 12px 22px;
    font-size: 17px;
  }
  .sticker--md {
    padding: 9px 16px;
    font-size: 15px;
  }
</style>
