---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Catalog from '../components/Catalog.astro';
import About from '../components/About.astro';
import { getCategories, getProducts, getSettings } from '../lib/content';

const [products, categories, site] = await Promise.all([getProducts(), getCategories(), getSettings()]);
---

<Base
  title="Stars & Stuff | Crochet hecho a mano en Panamá"
  description="Amigurumis, flores y accesorios tejidos a mano en Panamá. Colores a tu gusto y pedidos por WhatsApp."
>
  <Hero products={products} tagline={site.heroTagline} whatsapp={site.whatsapp} />
  <Catalog products={products} categories={categories} whatsapp={site.whatsapp} />
  <About title={site.aboutTitle} text={site.aboutText} photo={site.aboutPhoto} gallery={site.gallery} />
</Base>
